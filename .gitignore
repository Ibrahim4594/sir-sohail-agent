# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/
/build

# typescript
*.tsbuildinfo
next-env.d.ts

# env files — commit only .env.example
.env*
!.env.example

# vercel
.vercel

# seed PDFs — uploaded to Supabase Storage, not source-controlled
pdfs/*.pdf

# Supabase local stack state
supabase/.branches
supabase/.temp

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
*.pem
