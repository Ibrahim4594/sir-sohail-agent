# Sir Sohail Agent — local environment template.
# Copy to .env.local and fill in the Supabase + Gemini values.

# Gemini — the one and only LLM provider.
# Changing GEMINI_EMBEDDING_MODEL changes the embedding space; you MUST
# re-run `pnpm ingest:corpus` after any embedding-model change or
# retrieval will silently degrade.
GEMINI_API_KEY=
# GEMINI_MODEL is the answer model — Pro for the streamed response
# users actually see. GEMINI_HELPER_MODEL is used for the four cheap
# pipeline calls (intent classification, reranking, entailment audit,
# title + follow-up generation) where Flash is plenty and ~10x
# cheaper. Two-tier setup added 2026-04-25.
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_HELPER_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Supabase — hosted or local. service_role key is server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Retrieval tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_SIMILARITY_THRESHOLD=0.5

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
